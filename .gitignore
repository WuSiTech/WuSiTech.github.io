# ============ Hugo ============
# 构建产物：GitHub Actions 会在 CI 中重新生成（hugo --minify），无需提交
/public/

# Hugo 的资源缓存（图片处理 / SCSS 编译缓存），仅根目录这份
/resources/

# Hugo 构建时生成的锁文件
/.hugo_build.lock

# ============ 本地临时目录 ============
.dbg/
# 构建/验证时使用的临时输出目录（仅根目录）
/.verify*/
/.imgwork/
/.shot/

# ============ 系统 / 编辑器 ============
.DS_Store
Thumbs.db
desktop.ini

# ============ Python ============
# 本地虚拟环境：不进版本库（曾在某次操作中误提交，已移除跟踪）
.venv/
__pycache__/
*.py[cod]

# 注意：static/resources/ 是主题的本地 vendor 库，必须保留跟踪，不要 ignore。

# ============ Obsidian ============
.obsidian/workspace*.json
.obsidian/cache
.obsidian/plugins/obsidian-git/data.json
