{{- $pages := where .Site.RegularPages "Type" "in" .Site.Params.mainSections -}}
[{{- range $i, $p := $pages -}}{{- if $i }},{{ end }}{{ dict "title" $p.Title "url" $p.RelPermalink "summary" ($p.Summary | plainify | truncate 160) "tags" ($p.Params.tags | default (slice)) "date" ($p.Date.Format "2006-01-02") | jsonify }}{{- end -}}]
